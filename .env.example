# ============================================================
# AI Personal Assistant — Environment Variables Template
# ============================================================
# 1. Copy this file:  cp .env.example .env   (Windows: copy .env.example .env)
# 2. Fill in your own values — NEVER commit the real .env file.
# ============================================================

# --- Core ---
APP_NAME="AI Personal Assistant"
APP_DEBUG=true
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Telegram (required) ---
# Get a token from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Optional secret token Telegram sends with each webhook request
WEBHOOK_SECRET=
# Public HTTPS URL for webhook mode, e.g. https://bot.example.com
# Leave empty to use polling mode (development)
WEBHOOK_URL=

# --- OpenRouter LLM (required) ---
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash-0731
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# --- PostgreSQL (production; not needed in SQLite dev mode) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=assistant_agent

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Celery (defaults use Redis DBs 1 and 2) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Qdrant (vector DB for RAG) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# --- Google OAuth (for Calendar integration) ---
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Server ---
HOST=0.0.0.0
PORT=8000